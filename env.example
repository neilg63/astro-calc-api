# Copy to .env and edit. Variables set in the real environment override this file.

# Folder holding the JPL .bsp ephemeris files.
ASTRO_DATA_DIR=../astro-calc-core/data

# Station table file. Defaults to stations.bin inside ASTRO_DATA_DIR.
# ASTRO_STATION_TABLE=../astro-calc-core/data/stations.bin

# Address and port to listen on. Use 0.0.0.0 to accept connections from other machines.
HOST=127.0.0.1
PORT=8087
